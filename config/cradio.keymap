#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define KRIT 0
#define BLND 1

/ {
    behaviors {
        // Double-tap I to toggle between Krita and Blender layers
        td_toggle: tap_dance_toggle {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp I>, <&tog BLND>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─────────────────────────────────────────────────────
        // KRITA LAYER (default)
        //
        // Right half layout:
        //
        //   [left half = all trans]    KP7   KP8   I(dbl)  KP9   KP+
        //   [left half = all trans]    KP4   KP5   KP6     KP-   [
        //   [left half = all trans]    CTRL  SHFT  KP1     KP2   KP3
        //                  [trans]  [trans]  CTRL  SHFT
        //
        // Krita numpad reference:
        //   KP7/8/9 = rotate canvas L / reset / rotate R
        //   KP4/5/6 = free (assign in Krita settings)
        //   KP1/2/3 = free
        //   KP+ / KP- = brush size up / down
        //   [ / ]    = brush size down / up (Krita default keys)
        // ─────────────────────────────────────────────────────
        krita_layer {
            display-name = "Krita";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &trans     &trans     &trans     &trans     &trans         &kp KP_N7  &kp KP_N8  &td_toggle &kp KP_N9  &kp KP_PLUS
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &trans     &trans     &trans     &trans     &trans         &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS &kp LBKT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &trans     &trans     &trans     &trans     &trans         &kp LCTRL  &kp LSHFT  &kp KP_N1  &kp KP_N2  &kp KP_N3
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &kp LCTRL  &kp LSHFT
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        // ─────────────────────────────────────────────────────
        // BLENDER LAYER (double-tap I to toggle, again to return)
        //
        //   KP7=top    KP8=rot↑   I(dbl)=exit  KP9=opposite  Z=xray
        //   KP4=rot←   KP5=persp  KP6=rot→     KP-=zoom out  Tab=edit mode
        //   CTRL       SHFT       KP1=front     KP2=rot↓      KP3=right
        //                         CTRL          SHFT
        //
        // Blender numpad reference:
        //   KP1=front  KP3=right  KP7=top
        //   KP2/4/6/8 = rotate view
        //   KP5 = toggle ortho/perspective
        //   KP9 = opposite view
        //   KP+ / KP- = zoom in / out
        // ─────────────────────────────────────────────────────
        blender_layer {
            display-name = "Blender";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &trans     &trans     &trans     &trans     &trans         &kp KP_N7  &kp KP_N8  &td_toggle &kp KP_N9  &kp Z
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &trans     &trans     &trans     &trans     &trans         &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS &kp TAB
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &trans     &trans     &trans     &trans     &trans         &kp LCTRL  &kp LSHFT  &kp KP_N1  &kp KP_N2  &kp KP_N3
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &kp LCTRL  &kp LSHFT
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
