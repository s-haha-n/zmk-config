#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define KRIT 0
#define BLND 1
#define DESEL &kp LC(LS(A))

/ {
    behaviors {
        // Double-tap I to toggle between Krita and Blender layers
        td_toggle: tap_dance_toggle {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp I>, <&tog BLND>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        krita_layer {
            display-name = "Krita";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &trans     &trans     &trans     &trans     &trans         DESEL      &kp DEL    &td_toggle &kp KP_N9  &kp KP_PLUS
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &trans     &trans     &trans     &trans     &trans         &kp KP_N7  &kp LC(T)  &kp KP_N6  &kp B      &kp LC(LS(Z)) 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &trans     &trans     &trans     &trans     &trans         &kp B      &kp E      &kp SLASH  &kp KP_N2  &kp LC(Z) 
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &kp LCTRL  &kp LSHFT
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        // ─────────────────────────────────────────────────────
        // BLENDER LAYER (double-tap I to toggle, again to return)
        //
        //   KP7=top    KP8=rot↑   I(dbl)=exit  KP9=opposite  Z=xray
        //   KP4=rot←   KP5=persp  KP6=rot→     KP-=zoom out  Tab=edit mode
        //   CTRL       SHFT       KP1=front     KP2=rot↓      KP3=right
        //                         CTRL          SHFT
        //
        // Blender numpad reference:
        //   KP1=front  KP3=right  KP7=top
        //   KP2/4/6/8 = rotate view
        //   KP5 = toggle ortho/perspective
        //   KP9 = opposite view
        //   KP+ / KP- = zoom in / out
        // ─────────────────────────────────────────────────────
        blender_layer {
            display-name = "Blender";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &trans     &trans     &trans     &trans     &trans         &kp KP_N7  &kp KP_N8  &td_toggle &kp KP_N9  &kp Z
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &trans     &trans     &trans     &trans     &trans         &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS &kp TAB
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &trans     &trans     &trans     &trans     &trans         &kp LCTRL  &kp LSHFT  &kp KP_N1  &kp KP_N2  &kp KP_N3
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &kp LCTRL  &kp LSHFT
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
